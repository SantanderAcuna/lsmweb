# ---------------------------------------------------------------------------
# .env.docker.example — copy to `.env` at the repo root for `docker compose`.
#   cp .env.docker.example .env
# Replace every placeholder before bringing the stack up. Never commit `.env`.
# ---------------------------------------------------------------------------

# ---- Laravel ----
APP_ENV=local
APP_DEBUG=true
# Generate with: docker compose run --rm backend php artisan key:generate --show
APP_KEY=
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-root
DB_DATABASE=lsmweb
DB_USERNAME=lsmweb
DB_PASSWORD=change-me-app
MYSQL_PORT=3306

# ---- Redis (optional, enabled with --profile redis) ----
REDIS_PORT=6379

# ---- Host-side ports (override if collisions) ----
BACKEND_HTTP_PORT=8000
FRONTEND_HTTP_PORT=8080
