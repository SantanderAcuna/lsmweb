    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "@tanstack/vue-query": "^5.51.0",
    "@vee-validate/yup": "^4.13.0",
    "axios": "^1.7.0",
    "bootstrap": "^5.3.3",
    "pinia": "^2.2.0",
    "vee-validate": "^4.13.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0",
    "vue-toastification": "^2.0.0-rc.5",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@types/bootstrap": "^5.2.10",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.1.0",
