{
  "name": "lsmweb-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Frontend Vue 3 + TS — Sitio web Alcaldía Distrital de Santa Marta. Cumple WCAG 2.1 AA (Resolución 1519/2020).",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
