APP_NAME="Alcaldía Distrital de Santa Marta"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Bogota
APP_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lsmweb
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@santamarta.gov.co"
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:5173
